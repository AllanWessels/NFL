# Data & model artifacts (never committed).
# Root-anchored: bare `data/` would also ignore the `nfl/data/` package.
/data/
/models/
*.parquet
*.duckdb
*.duckdb.wal
*.csv
# ...except the hand-maintained static reference tables, which are committed.
!nfl/data/reference/*.csv
*.feather
*.h5
*.keras
*.joblib
*.pkl

# ...except the tiny hand-built fixtures the offline tests read, and the
# committed static reference tables.
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.csv
!nfl/data/reference/*.csv
# ...except recorded test fixtures, which the suite cannot run without.
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.csv

# Environments & secrets
.venv/
venv/
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Notebooks
.ipynb_checkpoints/
.claude/worktrees/
/notes
